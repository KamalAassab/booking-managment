# Copy to .env.local and fill in. Never commit .env.local — .gitignore
# covers every .env* file except this example.

# Neon Postgres connection string, from the Neon console (use the *pooled*
# host). A plain postgres://localhost/... URL also works and switches the app
# to the node-postgres driver for local development.
DATABASE_URL='postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require'

# Secret used to sign the session cookie. Generate a fresh one per
# environment — changing it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET='change-me-at-least-16-characters-long'

# Optional: initial passwords for the two accounts created by `npm run db:seed`.
# Leave unset and the seed generates and prints them once.
# SEED_STAFF_PASSWORD=''
# SEED_OWNER_PASSWORD=''

# The salon's own WhatsApp number — the account each call-centre browser is
# linked to as a companion device. Confirmations are sent from it. Optional:
# a sensible default is compiled in, this only overrides it per environment.
# SALON_WHATSAPP_NUMBER='+212766092140'
